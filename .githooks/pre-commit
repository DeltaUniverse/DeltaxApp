#!/bin/sh
set -e

echo "🔍 Running pre-commit verification..."

# 1. Module registry check
echo "👉 Verifying module auto-import registry..."
npm run generate:modules
if ! git diff --quiet src/modules/index.ts; then
  echo "❌ Error: src/modules/index.ts is out of date. Please stage the generated module registry."
  exit 1
fi

# 2. TypeScript typecheck
echo "👉 Running TypeScript typecheck..."
npm run typecheck

# 3. Test suite
echo "👉 Running test suite..."
npm test

echo "✅ All pre-commit checks passed successfully!"
