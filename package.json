{
  "name": "deltax-app",
  "version": "1.2.0",
  "description": "Deltax App - Modular Serverless Telegram Bot on Cloudflare Workers",
  "type": "module",
  "scripts": {
    "generate:modules": "node scripts/auto_import.mjs",
    "watch:modules": "node scripts/auto_import.mjs --watch",
    "make:module": "node scripts/create_module.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "check": "npm run format:check && npm run lint && npm run typecheck",
    "clean": "node -e 'fs.rmSync(\"dist\", { recursive: true, force: true }); fs.rmSync(\".wrangler\", { recursive: true, force: true })'",
    "predev": "node scripts/auto_import.mjs",
    "dev": "wrangler dev",
    "prebuild": "node scripts/auto_import.mjs",
    "build": "node scripts/auto_import.mjs && wrangler deploy --dry-run --outdir dist",
    "deploy": "node scripts/auto_import.mjs && wrangler deploy",
    "test": "node --test tests/*.test.mjs",
    "prepare": "husky && node scripts/fix_termux.mjs"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "keywords": [
    "telegram",
    "telegram-bot",
    "grammy",
    "cloudflare-workers",
    "wrangler",
    "serverless",
    "modular",
    "oop"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@grammyjs/auto-retry": "^2.0.2",
    "@grammyjs/parse-mode": "^2.3.0",
    "grammy": "^1.46.0",
    "hono": "^4.13.13"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261019.1",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "wrangler": "^4.123.0"
  }
}
